<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!--
          These files go to the user's own Google account when Android backup is enabled. The
          platform encrypts the backup; AutoSpot never receives or has access to it. Keep this
          list in sync with backup_rules.xml and the privacy policy.
        -->
        <include domain="database" path="parking_database" />
        <include domain="database" path="parking_database-shm" />
        <include domain="database" path="parking_database-wal" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <!-- A direct transfer between the user's own devices keeps everything. -->
        <include domain="database" path="parking_database" />
        <include domain="database" path="parking_database-shm" />
        <include domain="database" path="parking_database-wal" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
