<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!--
          The parking database is excluded from cloud backup on purpose. Only the onboarding flag
          is uploaded, and it contains no personal data. A device-to-device transfer keeps the
          vehicles and the parking history (see the device-transfer section below). Declaring
          only the datastore as an include is what excludes the database from this section.
        -->
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <!-- A direct transfer between the user's own devices keeps everything. -->
        <include domain="database" path="parking_database" />
        <include domain="database" path="parking_database-shm" />
        <include domain="database" path="parking_database-wal" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
