<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Backup Room database with vehicles and locations -->
        <include domain="database" path="parking_database" />
        <include domain="database" path="parking_database-shm" />
        <include domain="database" path="parking_database-wal" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <!-- Transfer Room database when switching devices -->
        <include domain="database" path="parking_database" />
        <include domain="database" path="parking_database-shm" />
        <include domain="database" path="parking_database-wal" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>