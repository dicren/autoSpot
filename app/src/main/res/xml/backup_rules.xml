<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!--
      Android backup copies these files to the user's own Google account, encrypted by the
      platform. They never reach a server controlled by AutoSpot. Keep this list in sync with
      data_extraction_rules.xml and the privacy policy.
    -->
    <include domain="database" path="parking_database" />
    <include domain="database" path="parking_database-shm" />
    <include domain="database" path="parking_database-wal" />
    <include domain="file" path="datastore/settings.preferences_pb" />
</full-backup-content>
