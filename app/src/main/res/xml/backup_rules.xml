<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!--
      The parking database contains the vehicle list and the location history. It is deliberately
      kept out of Android cloud backup: the privacy policy promises that this data stays on the
      device. A direct device-to-device transfer still copies it (see data_extraction_rules.xml).
      Declaring only the onboarding flag as an include is what excludes the rest.
    -->
    <include domain="file" path="datastore/settings.preferences_pb" />
</full-backup-content>
