<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.AutoSpot" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="android:windowSplashScreenBackground">?android:colorBackground</item>
    </style>

    <style name="Theme.AutoSpot.Dialog" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
